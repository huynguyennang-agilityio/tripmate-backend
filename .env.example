# Every setting the backend reads, with no value: the repository is public.
# The app reads environment variables only; it never reads a .env file.
# Locally, set them in your shell; compose.yaml runs only PostgreSQL and Redis.

# PostgreSQL, postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=
# Redis, redis://<host>:<port>/<db>
REDIS_URL=
# The release version GET /v1/health returns
RELEASE_VERSION=
# Port of the API process (optional, 8000 when not set)
PORT=
# Public keys that verify access tokens: one or more PEM Ed25519 public keys one after
# another (optional; without it every route that is not public answers 401)
ACCESS_TOKEN_PUBLIC_KEYS=
# The general ceiling: requests a minute for one IP address and for one user (optional, 300
# when not set; 0 turns the general ceiling off, a route's own limit still applies)
RATE_LIMIT_PER_MINUTE=
# Sentry DSN for error reporting (optional; without it nothing goes to Sentry)
SENTRY_DSN=
# OTLP/HTTP base address of the trace and metric collector, http:// or https:// (optional;
# without it no trace or metric leaves the process)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Headers sent with each export, key=value pairs separated by commas, values URL-encoded
# (optional; the collector's Authorization lives here)
OTEL_EXPORTER_OTLP_HEADERS=
